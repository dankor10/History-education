<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B0A179"
    tools:context=".LoginTry">

    <ImageView
        android:id="@+id/imageView13"
        android:layout_width="375dp"
        android:layout_height="81dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="228dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ellipse_6" />

    <EditText
        android:id="@+id/editTextUsername"
        android:layout_width="338dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:hint="iмя"
        app:layout_constraintStart_toStartOf="@+id/imageView13"
        app:layout_constraintTop_toTopOf="@+id/imageView13" />


    <ImageView
        android:id="@+id/imageView13567"
        android:layout_width="375dp"
        android:layout_height="81dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="332dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ellipse_6" />

    <EditText
        android:id="@+id/editTextPassword"
        android:layout_width="338dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:hint="пароль"
        android:inputType="textPassword"
        app:layout_constraintStart_toStartOf="@+id/imageView13567"
        app:layout_constraintTop_toTopOf="@+id/imageView13567" />

    <Button
        android:id="@+id/buttonregistr"
        android:layout_width="176dp"
        android:layout_height="69dp"
        android:backgroundTint="#EAAA2E"
        android:text="увайсці"
        android:textColor="@color/black"
        android:textSize="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.761" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="92dp"
        android:text="Вайсцi"
        android:textColor="@color/black"
        android:textSize="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:textColor="#4C4A4A"
        android:textSize="16dp"
        android:text="Вiтаем у ЦIКАVА! Калi ласка ўвядзіце свае данные"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <TextView
        android:id="@+id/textView20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="572dp"
        android:textColor="#4C4A4A"
        android:text="Яшчэ не зарэгістраваны?"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/buttonlogintest"
        android:layout_width="120dp"
        android:layout_height="24dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="572dp"
        android:textColor="#165416"
        android:text="Зарэгістравацца"
        app:layout_constraintStart_toEndOf="@+id/textView20"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>