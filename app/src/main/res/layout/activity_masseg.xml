                android:layout_width="207dp"
                android:layout_height="206dp"
                android:layout_marginStart="76dp"
                android:layout_marginTop="28dp"
                android:text="17 января 1942 года белорусскими партизанами был освобождён первый районный центр — Копаткевичи."
                android:textColor="@color/black"
                android:textSize="20dp"
                app:layout_constraintStart_toStartOf="@+id/imageView17"
                app:layout_constraintTop_toTopOf="@+id/imageView17" />

            <ImageView
                android:id="@+id/imageView14"
                android:layout_width="118dp"
                android:layout_height="155dp"
                android:layout_marginStart="236dp"
                android:layout_marginTop="80dp"
                app:layout_constraintStart_toStartOf="@+id/imageView16"
                app:layout_constraintTop_toBottomOf="@+id/textView26"
                app:srcCompat="@drawable/coat_of_arms_of_minsk" />

            <ImageView
                android:id="@+id/imageView163"
                android:layout_width="220dp"
                android:layout_height="195dp"
                android:layout_marginStart="52dp"
                android:layout_marginTop="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView17"
                app:srcCompat="@drawable/ramka" />

            <TextView
                android:id="@+id/textView39"
                android:layout_width="181dp"
                android:layout_height="174dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:text="вы атрымалі новую ўзнагароду, падрабязней разгледзець можна ў вашых узнагародах"
                android:textColor="@color/black"
                android:textSize="20dp"
                app:layout_constraintStart_toStartOf="@+id/imageView163"
                app:layout_constraintTop_toTopOf="@+id/imageView163" />

            <ImageView
                android:id="@+id/imageView20"
                android:layout_width="121dp"
                android:layout_height="158dp"
                android:layout_marginStart="220dp"
                android:layout_marginTop="60dp"
                app:layout_constraintStart_toStartOf="@+id/imageView163"
                app:layout_constraintTop_toBottomOf="@+id/imageView17"
                app:srcCompat="@drawable/gerb1" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>